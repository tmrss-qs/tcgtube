# PARKED: Product Management corpus. Not built or linked. Same engine; to revive,
# copy to config/pm.yaml, fill in subreddits/taxonomy, and run with TCGTUBE_CONFIG=config/pm.yaml.
name: TCGTube PM (parked)
base_url: https://vault.tmrss.co/pm
tagline: Product management videos people keep recommending.
subreddits:
  - {name: ProductManagement, game: PM, start: 2012-01}
  - {name: ExperiencedDevs, game: PM, start: 2018-01}
ranking: {min_vouchers: 3, min_months: 3, count_stances: [recommend, cite], dated_after_years: 3}
exclude_channels: {handles: ["@tmrss"], names: ["tmrss"]}
deny_video_ids: [dQw4w9WgXcQ]
bot_authors: [AutoModerator]
shelf_file: config/shelves.yaml
